# Contoh konfigurasi — SALIN file ini jadi `.env`, lalu isi nilainya di sana.
# File `.env` sudah masuk .gitignore dan tidak akan ikut ter-commit.
#
# Nilai asli ada di Supabase: project fathia-stok -> Project Settings -> API.
# Pakai publishable key (sb_publishable_...), bukan legacy anon key JWT.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
